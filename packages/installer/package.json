{
  "name": "@btnlauncher2/installer",
  "version": "6.3.1",
  "main": "./index.ts",
  "browser": "./index.browser.ts",
  "description": "The installers of Minecraft/Forge/Fabric/Liteloader/Quilt",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:type": "tsc",
    "build:cjs": "esbuild --target=node16 --platform=node --external:@btnlauncher2/* --external:undici --sourcemap --format=cjs --bundle --outfile=dist/index.js index.ts",
    "build:esm": "esbuild --target=node16 --platform=node --external:@btnlauncher2/* --external:undici --sourcemap --format=esm --bundle --outfile=dist/index.mjs index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs"
  },
  "dependencies": {
    "@btnlauncher2/asm": "workspace:^*",
    "@btnlauncher2/core": "workspace:^*",
    "@btnlauncher2/file-transfer": "workspace:^*",
    "@btnlauncher2/forge-site-parser": "workspace:^*",
    "@btnlauncher2/unzip": "workspace:^*",
    "@btnlauncher2/yauzl": "workspace:^*",
    "tar-stream": "^3.1.7",
    "undici": "^7.24.0",
    "yazl": "^2.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qvietdpzai/Btnlaucher2-pc.git"
  },
  "sideEffects": false,
  "author": "cijhn@hotmail.com",
  "keywords": [
    "minecraft",
    "typescript",
    "minecraft-launcher",
    "nodejs",
    "electron"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Voxelum/minecraft-launcher-core-node/issues"
  },
  "homepage": "https://github.com/Voxelum/minecraft-launcher-core-node#readme",
  "devDependencies": {
    "@types/tar-stream": "^3.1.3",
    "@types/node": "^24.13.3",
    "@types/yazl": "^2.4.5",
    "@btnlauncher2/oxlint-config": "workspace:^*",
    "esbuild": "^0.25.12",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
